# ProcureGuard AI — local application / managed Supabase database
# Copy this file to .env.local and fill in the server-only values.
# Never commit .env.local and never place the secret key in client-side code.

SUPABASE_URL=https://chyszlgzjkfrpogmwdma.supabase.co
SUPABASE_SECRET_KEY=replace-with-your-server-only-supabase-secret-key

# Browser-safe authentication settings. The publishable key is not a secret.
VITE_SUPABASE_URL=https://chyszlgzjkfrpogmwdma.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-your-supabase-publishable-key

# Dissertation-only demo accounts are provisioned from this password.
# Change this before presenting the project outside your own computer.
DEMO_ACCOUNT_PASSWORD=ChangeThisDemoPassword!2026
